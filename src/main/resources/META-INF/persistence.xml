<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>ar.edu.practica.jpa.EntityId</class>
        <class>ar.edu.practica.jpa.AuditoriaApp</class>
        <class>ar.edu.practica.jpa.Usuario</class>
        <class>ar.edu.practica.jpa.FacturaVenta</class>
        <class>ar.edu.practica.jpa.FacturaVentaDetalle</class>
        <class>ar.edu.practica.jpa.PuntoVenta</class>
        <class>ar.edu.practica.jpa.TipoMoneda</class>
        <class>ar.edu.practica.jpa.Cliente</class>
        <class>ar.edu.practica.jpa.CondicionIva</class>
        <class>ar.edu.practica.jpa.Contacto</class>
        <class>ar.edu.practica.jpa.Domicilio</class>
        <class>ar.edu.practica.jpa.ListaPrecioArticulo</class>
        <class>ar.edu.practica.jpa.Articulo</class>
        <class>ar.edu.practica.jpa.ListaPrecio</class>
        <class>ar.edu.practica.jpa.Marca</class>
        <class>ar.edu.practica.jpa.Rubro</class>

        <properties>
            <!-- Propiedades estándar javax.persistence requeridas -->
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/facturacion_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <!-- Propiedades jakarta.persistence para compatibilidad completa en Hibernate 6 -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/facturacion_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Propiedades de configuración de Hibernate -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
        </properties>
    </persistence-unit>
</persistence>