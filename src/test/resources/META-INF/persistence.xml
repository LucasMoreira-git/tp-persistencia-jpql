<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>ar.edu.practica.jpa.EntityId</class>
        <class>ar.edu.practica.jpa.AuditoriaApp</class>
        <class>ar.edu.practica.jpa.Usuario</class>
        <class>ar.edu.practica.jpa.FacturaVenta</class>
        <class>ar.edu.practica.jpa.FacturaVentaDetalle</class>
        <class>ar.edu.practica.jpa.PuntoVenta</class>
        <class>ar.edu.practica.jpa.TipoMoneda</class>
        <class>ar.edu.practica.jpa.Cliente</class>
        <class>ar.edu.practica.jpa.CondicionIva</class>
        <class>ar.edu.practica.jpa.Contacto</class>
        <class>ar.edu.practica.jpa.Domicilio</class>
        <class>ar.edu.practica.jpa.ListaPrecioArticulo</class>
        <class>ar.edu.practica.jpa.Articulo</class>
        <class>ar.edu.practica.jpa.ListaPrecio</class>
        <class>ar.edu.practica.jpa.Marca</class>
        <class>ar.edu.practica.jpa.Rubro</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:facturacion_test;DB_CLOSE_DELAY=-1;MODE=MySQL"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
